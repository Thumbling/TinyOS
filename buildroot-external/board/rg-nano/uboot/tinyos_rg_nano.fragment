CONFIG_DEFAULT_DEVICE_TREE="allwinner/sun8i-v3s-anbernic-rg-nano"
CONFIG_BOOTDELAY=1
CONFIG_BOOTCOMMAND="mw.b 0x41700000 0x54 4; fatwrite mmc 0:3 0x41700000 UBOOT.TXT 4; if load mmc 0:1 0x41900000 boot.scr; then source 0x41900000; fi; run bootcmd_mmc0"
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_FAT=y
CONFIG_CMD_MMC=y
CONFIG_CMD_SOURCE=y
CONFIG_DRAM_CLK=360
CONFIG_FAT_WRITE=y
